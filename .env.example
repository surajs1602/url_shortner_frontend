# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# Your backend base URL (no trailing slash).
# Local dev : http://localhost:8081
# Render    : https://your-service.onrender.com
VITE_API_BASE_URL=

# Your deployed frontend URL — used to build shareable /go/:id short links.
# Falls back to window.location.origin at runtime (local dev works without this).
VITE_APP_URL=

# Your API key — must match the API_KEY set in the backend's .env.
# Sent as the x-api-key header on every authenticated request.
# WARNING: VITE_* vars are baked into the JS bundle at build time.
# Keep this file out of version control (.gitignore already covers .env).
# You can also override both values at runtime via the Settings modal.
VITE_API_KEY=
