# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# Your backend base URL (no trailing slash).
# Local dev : http://localhost:8081
# Render    : https://your-service.onrender.com
VITE_API_BASE_URL=

# Your API key — must match the API_KEY set in the backend's .env.
# Sent as the x-api-key header on every authenticated request.
# WARNING: VITE_* vars are baked into the JS bundle at build time.
# Keep this file out of version control (.gitignore already covers .env).
VITE_API_KEY=

# Your deployed frontend URL — used by the legacy /go/:id wake-up route.
# Public short links now point straight at the backend (${VITE_API_BASE_URL}/:id).
# Falls back to window.location.origin at runtime (local dev works without this).
VITE_APP_URL=

# Cloudflare Turnstile SITE key (public — safe to ship in the bundle).
# Leave empty to disable the CAPTCHA widget entirely. When set, the create and
# report forms render Turnstile and require a token before submitting.
VITE_TURNSTILE_SITE_KEY=

# ─── Admin BFF (server-side only — NOT VITE_ vars, never sent to the browser) ───
# These are read by the Vercel functions in /api/bff. Set them in the Vercel
# project's Environment Variables (or a local .env for `vercel dev`), NOT in the
# client bundle. The admin key never reaches the browser.

# Backend base URL the proxy forwards admin calls to (falls back to VITE_API_BASE_URL).
API_BASE_URL=

# Full-access admin credential — injected as x-admin-key on /admin/* requests.
ADMIN_API_KEY=

# Operator login password for the admin panel (POST /bff/login).
ADMIN_PANEL_PASSWORD=

# Secret used to sign the httpOnly session cookie. Use a long random string.
SESSION_SECRET=
